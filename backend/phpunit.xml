<?xml version="1.0" encoding="UTF-8"?>
<!--
  Configuración de pruebas de GEOEDUCA (aislada del entorno de desarrollo).
  - No usa la base de datos ni el .env de desarrollo: todas las variables se fuerzan aquí.
  - La APP_KEY es un valor falso exclusivo de pruebas.
  - Suites:
      Caracterizacion      -> fija el comportamiento ACTUAL (debe aprobar, incluso los defectos conocidos).
      RequisitosSeguridad  -> comportamiento seguro (F1.2/F1.3: carnet, recuperación, IDOR).
      Persistencia         -> esquema, relaciones y CRUD Eloquent en SQLite :memory: (F1.1).
      Autenticacion        -> login Sanctum, expiración, revocación y aislamiento (F1.2).
-->
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         cacheDirectory=".phpunit.cache"
         colors="true"
         executionOrder="default"
         failOnRisky="true"
         failOnWarning="true"
         beStrictAboutOutputDuringTests="true">
    <testsuites>
        <testsuite name="Caracterizacion">
            <directory>tests/Caracterizacion</directory>
        </testsuite>
        <testsuite name="RequisitosSeguridad">
            <directory>tests/Seguridad</directory>
        </testsuite>
        <testsuite name="Persistencia">
            <directory>tests/Persistencia</directory>
        </testsuite>
        <testsuite name="Autenticacion">
            <directory>tests/Autenticacion</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <env name="APP_ENV" value="testing" force="true"/>
        <env name="APP_KEY" value="base64:MDEyMzQ1Njc4OWFiY2RlZjAxMjM0NTY3ODlhYmNkZWY=" force="true"/>
        <env name="APP_DEBUG" value="false" force="true"/>
        <env name="APP_URL" value="http://localhost" force="true"/>
        <env name="FRONTEND_URL" value="http://localhost:5173" force="true"/>
        <env name="CACHE_STORE" value="array" force="true"/>
        <env name="DB_CONNECTION" value="sqlite" force="true"/>
        <env name="DB_DATABASE" value=":memory:" force="true"/>
        <env name="DB_FOREIGN_KEYS" value="true" force="true"/>
        <env name="LOG_CHANNEL" value="null" force="true"/>
        <env name="MAIL_MAILER" value="array" force="true"/>
        <env name="QUEUE_CONNECTION" value="sync" force="true"/>
        <env name="SESSION_DRIVER" value="array" force="true"/>
        <env name="BCRYPT_ROUNDS" value="4" force="true"/>
        <env name="SANCTUM_EXPIRATION" value="120" force="true"/>
        <env name="GEO_RECOVERY_TTL" value="15" force="true"/>
        <env name="GEO_RECOVERY_MAX_ATTEMPTS" value="5" force="true"/>
        <env name="GEO_RECOVERY_DEV_REVEAL" value="false" force="true"/>
    </php>
</phpunit>
