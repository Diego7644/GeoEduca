APP_NAME=GEOEDUCA
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_TIMEZONE=America/Lima
APP_URL=http://localhost:8000
APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_PE

APP_MAINTENANCE_DRIVER=file

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

# Valores solo para Docker local. No son las credenciales de una base ya existente.
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=geoeduca
DB_USERNAME=geoeduca
# El instalador escribe aquí una clave aleatoria solo en backend/.env. No la dejes en el repositorio.
DB_PASSWORD=

# Contraseña compartida de las cuentas ficticias de db:seed. Solo demostración local.
GEO_DEV_PASSWORD=prueba123

# La demostración académica no copia las cuentas históricas del prototipo.
GEO_SEED_PROTOTYPE=false

SANCTUM_EXPIRATION=120

GEO_RECOVERY_TTL=15
GEO_RECOVERY_MAX_ATTEMPTS=5
GEO_RECOVERY_DEV_REVEAL=false

SESSION_DRIVER=file
SESSION_LIFETIME=120

CACHE_STORE=file
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local

FRONTEND_URL=http://localhost:5173
