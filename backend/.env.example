APP_NAME=GEOEDUCA
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost:8000
APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_PE

APP_MAINTENANCE_DRIVER=file

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

# Motor real: PostgreSQL (ver docs/02-desarrollo/CONFIGURACION-POSTGRES.md).
# El prototipo actual todavía guarda el estado en JSON y no consulta estas tablas.
# Sin PostgreSQL se puede dejar sqlite solo para arrancar Laravel.
# Si el puerto 5432 está ocupado (PostgreSQL de Windows), use DB_PORT=5433
# y el mismo valor al levantar Docker: docker compose --env-file backend/.env up -d
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=geoeduca
DB_USERNAME=geoeduca
DB_PASSWORD=

# Contraseña de los usuarios ficticios de `db:seed` (solo APP_ENV=local). No uses cuentas reales.
GEO_DEV_PASSWORD=

# DB_CONNECTION=sqlite
# DB_DATABASE=database/database.sqlite

SESSION_DRIVER=file
SESSION_LIFETIME=120

CACHE_STORE=file
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local

FRONTEND_URL=http://localhost:5173
